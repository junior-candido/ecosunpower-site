---
// Faixa de certificação GoodWe PLUS+ — home
---

<section class="bg-navy-800 border-y border-navy-line py-10">
  <div class="container-wide">
    <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-10 max-w-4xl mx-auto text-center md:text-left">
      <img
        src="/certificados/selo-goodwe-plus.png"
        alt="Selo GoodWe PLUS+ Installer"
        class="w-24 lg:w-28 drop-shadow-[0_6px_18px_rgba(0,0,0,0.45)] shrink-0"
        loading="lazy"
      />
      <div>
        <div class="font-mono text-[11px] tracking-[0.16em] uppercase text-accent-500 mb-1">Reconhecimento de fábrica</div>
        <h3 class="font-display font-bold text-ink text-xl lg:text-2xl leading-snug">
          Instaladora Certificada <span class="text-accent-400">GoodWe PLUS+</span>
        </h3>
        <p class="text-sm text-ink-mut mt-1.5 max-w-xl">
          Treinamento oficial completo de fábrica — produtos, baterias &amp; BESS e comissionamento.
          Instalação conforme o manual = <strong class="text-ink">sua garantia protegida</strong>.
        </p>
      </div>
      <a href="/certificacoes" class="shrink-0 inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white font-bold text-sm px-5 py-3 rounded-full transition-colors">
        Ver certificado
      </a>
    </div>
  </div>
</section>
